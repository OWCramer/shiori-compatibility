---
import { statusInfo, type Status } from "~/lib/games";

interface Props {
  status: Status;
}
const { status } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-fg ring-1 ring-line backdrop-blur">
  <span class:list={["size-1.5 rounded-full", statusInfo[status].dot]} aria-hidden="true"></span>
  {statusInfo[status].label}
</span>
