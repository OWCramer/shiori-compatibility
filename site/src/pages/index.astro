---
import { Image } from "astro:assets";
import Base from "~/layouts/Base.astro";
import GameCard from "~/components/GameCard.astro";
import icon from "~/assets/shiori.png";
import {
  appPage,
  counts,
  engineRepos,
  engines,
  entries,
  formatDate,
  lastTested,
  repo,
  reportURL,
  shortName,
  statusInfo,
  statuses,
} from "~/lib/games";

const playable = counts.complete + counts.plays;
const steps = [
  { title: "Fill in the form", body: "The game, its Steam app id, engine, status and the devices you played on." },
  { title: "We check it", body: "A maintainer reviews the report and accepts it." },
  { title: "It's on the list", body: "Accepted reports become an entry here and on the game's page in Shiori." },
];
---

<Base>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 h-[32rem] bg-[radial-gradient(50%_60%_at_50%_0%,color-mix(in_oklab,var(--accent)_18%,transparent),transparent)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-page relative pt-16 sm:pt-20">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-center">
        <Image src={icon} alt="" width={96} height={96} densities={[1, 2]} loading="eager" class="app-icon size-20 shrink-0 bg-white sm:size-24" />
        <div>
          <p class="eyebrow">Compatibility</p>
          <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Which games play in Shiori</h1>
          <p class="mt-4 max-w-2xl text-lg text-pretty text-muted">
            Steam visual novels tested on iPhone, iPad and Apple TV, each running on a native runtime for its engine.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={appPage} class="btn btn-primary">Get Shiori</a>
            <a href={reportURL()} class="btn btn-secondary">Report a game</a>
          </div>
        </div>
      </div>

      <dl class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-3xl border border-line bg-surface p-5">
          <dt class="text-sm text-muted">Tested</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight">{entries.length}</dd>
        </div>
        <div class="rounded-3xl border border-line bg-surface p-5">
          <dt class="text-sm text-muted">Playable</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight" style="color: var(--accent)">{playable}</dd>
        </div>
        <div class="rounded-3xl border border-line bg-surface p-5">
          <dt class="text-sm text-muted">Engines</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight">{engines.length}</dd>
        </div>
        <div class="rounded-3xl border border-line bg-surface p-5">
          <dt class="text-sm text-muted">Last tested</dt>
          <dd class="mt-2 text-lg font-semibold tracking-tight">{lastTested ? formatDate(lastTested) : "—"}</dd>
        </div>
      </dl>

      {/* Share of the list in each status. */}
      <div class="mt-6 flex h-2 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
        {statuses.map((s) => counts[s] > 0 && <div class={statusInfo[s].dot} style={`width: ${(counts[s] / entries.length) * 100}%`} />)}
      </div>
    </div>
  </section>

  <section id="games" class="container-page mt-16 scroll-mt-20" aria-labelledby="games-title">
    <h2 id="games-title" class="sr-only">Games</h2>
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Status">
        <button type="button" data-status-filter="all" aria-pressed="true" class="chip">
          All <span class="chip-count">{entries.length}</span>
        </button>
        {
          statuses.map((s) => (
            <button type="button" data-status-filter={s} aria-pressed="false" class="chip" title={statusInfo[s].meaning}>
              <span class:list={["size-1.5 rounded-full", statusInfo[s].dot]} aria-hidden="true" />
              {statusInfo[s].label} <span class="chip-count">{counts[s]}</span>
            </button>
          ))
        }
      </div>
      <div class="flex gap-2">
        <label class="sr-only" for="engine">Engine</label>
        <select id="engine" class="field pr-8">
          <option value="all">All engines</option>
          {engines.map((e) => <option value={e.engine}>{shortName(e.name)}</option>)}
        </select>
        <label class="sr-only" for="search">Search</label>
        <input id="search" type="search" placeholder="Search" autocomplete="off" class="field w-full min-w-0 lg:w-56" />
      </div>
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-grid>
      {entries.map((game) => <GameCard game={game} />)}
    </div>
    <p data-empty hidden class="mt-6 rounded-3xl border border-dashed border-line p-10 text-center text-muted">
      No games match. <a href={reportURL()} class="font-medium text-fg underline underline-offset-[3px]">Report one</a>
    </p>
  </section>

  <section id="engines" class="container-page mt-24 scroll-mt-20" aria-labelledby="engines-title">
    <h2 id="engines-title" class="text-3xl font-semibold tracking-tight">Engines</h2>
    <p class="mt-3 max-w-2xl text-muted">Each engine has its own runtime, and most are open-source Swift packages.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        engines.map((e) => {
          const playing = e.games.filter((g) => g.status === "complete" || g.status === "plays").length;
          const href = engineRepos[e.engine];
          return (
            <article class="reveal group relative flex flex-col rounded-3xl border border-line bg-surface p-6 transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_-30px_var(--accent)]">
              <h3 class="text-xl font-semibold tracking-tight">
                {href ? (
                  <a href={href} class="after:absolute after:inset-0 after:rounded-3xl after:content-['']">
                    {shortName(e.name)}
                  </a>
                ) : (
                  shortName(e.name)
                )}
              </h3>
              {e.name !== shortName(e.name) && <p class="mt-0.5 font-mono text-xs text-muted">{e.name.match(/\((.*)\)/)?.[1]}</p>}
              {e.runtimes && <p class="mt-3 text-sm text-muted">{e.runtimes}</p>}
              <p class="mt-auto pt-5 text-sm text-muted">
                <span class="font-semibold text-fg">{playing}</span> of {e.games.length} playable
              </p>
              <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
                {statuses.map((s) => {
                  const n = e.games.filter((g) => g.status === s).length;
                  return n > 0 && <div class={statusInfo[s].dot} style={`width: ${(n / e.games.length) * 100}%`} />;
                })}
              </div>
            </article>
          );
        })
      }
    </div>

    <dl class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        statuses.map((s) => (
          <div>
            <dt class="flex items-center gap-2 font-semibold">
              <span class:list={["size-2 rounded-full", statusInfo[s].dot]} aria-hidden="true" />
              {statusInfo[s].label}
            </dt>
            <dd class="mt-1 text-sm text-muted">{statusInfo[s].meaning}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="report" class="container-page mt-24 scroll-mt-20" aria-labelledby="report-title">
    <div class="rounded-3xl border border-line bg-surface p-6 sm:p-10">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 id="report-title" class="text-3xl font-semibold tracking-tight">Report a game</h2>
          <p class="mt-3 max-w-xl text-muted">Played something that isn't listed, or plays better than it says? Tell us on GitHub.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={reportURL()} class="btn btn-primary">Report a game</a>
          <a href={`${repo}/tree/main/engines`} class="btn btn-secondary">Edit the files</a>
        </div>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li>
              <span class="flex size-8 items-center justify-center rounded-full text-sm font-semibold text-white" style="background: var(--accent)">
                {i + 1}
              </span>
              <h3 class="mt-3 font-semibold">{step.title}</h3>
              <p class="mt-1 text-sm text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-10 text-sm text-muted">Reports are dedicated to the public domain under CC0 1.0.</p>
    </div>
  </section>
</Base>

<style>
  @reference "../styles/global.css";

  .chip {
    @apply inline-flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-muted ring-1 ring-line transition hover:text-fg;
  }
  .chip[aria-pressed="true"] {
    @apply bg-fg text-bg ring-fg;
  }
  .chip-count {
    @apply text-xs opacity-60;
  }
  .field {
    @apply h-9 rounded-full bg-surface px-4 text-sm text-fg ring-1 ring-line outline-none placeholder:text-muted focus:ring-2 focus:ring-[var(--accent)];
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>("[data-grid]")!;
  const cards = [...grid.querySelectorAll<HTMLElement>("[data-game]")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-status-filter]")];
  const engine = document.querySelector<HTMLSelectElement>("#engine")!;
  const search = document.querySelector<HTMLInputElement>("#search")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;

  let status = "all";

  function apply() {
    const query = search.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const match =
        (status === "all" || card.dataset.status === status) &&
        (engine.value === "all" || card.dataset.engine === engine.value) &&
        (!query || card.dataset.search!.includes(query));
      card.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      status = chip.dataset.statusFilter!;
      for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
      apply();
    });
  }
  engine.addEventListener("change", apply);
  search.addEventListener("input", apply);
</script>
